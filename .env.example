# Firebase Configuration (Frontend - Public)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your_firebase_project.firebaseio.com
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Frontend App URL (for API CORS)
VITE_APP_URL=http://localhost:5173

# Backend Environment Variables (Server-side only - Vercel Functions)
# WARNING: Never expose these in the frontend!
ANTHROPIC_API_KEY=sk_your_anthropic_api_key

# Firebase Admin SDK (for server-side auth verification)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your_firebase_project.iam.gserviceaccount.com

# Notes:
# 1. Get VITE_FIREBASE_* values from Firebase Console > Project Settings
# 2. Get ANTHROPIC_API_KEY from https://console.anthropic.com
# 3. Get FIREBASE_PRIVATE_KEY and FIREBASE_CLIENT_EMAIL from Firebase Console > Service Accounts
#    Download the JSON key file and extract these values
# 4. For FIREBASE_PRIVATE_KEY in .env, replace \n with literal newlines or use escaped \\n
# 5. On Vercel, set environment variables in Settings > Environment Variables
