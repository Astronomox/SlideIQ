rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }
    
    // Helper function to check if user is the owner
    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // UPLOADS Collection - User's PDF uploads and extracted text
    match /uploads/{uploadId} {
      // Only authenticated users can read their own uploads
      allow read: if isAuth() && isOwner(resource.data.uid);
      
      // Only authenticated users can create uploads
      allow create: if isAuth() && isOwner(request.resource.data.uid);
      
      // Users can only delete their own uploads
      allow delete: if isAuth() && isOwner(resource.data.uid);
      
      // No updates allowed to prevent inconsistency
      allow update: if false;
    }

    // QUIZ_SESSIONS Collection - Quiz attempts and scores
    match /quiz_sessions/{sessionId} {
      // Only authenticated users can read their own sessions
      allow read: if isAuth() && isOwner(resource.data.uid);
      
      // Only authenticated users can create sessions
      allow create: if isAuth() && isOwner(request.resource.data.uid);
      
      // Users can update only their own sessions
      allow update: if isAuth() && isOwner(resource.data.uid);
      
      // Users can delete their own sessions
      allow delete: if isAuth() && isOwner(resource.data.uid);
    }

    // QUIZ_RESULTS Collection - Detailed results from each quiz session
    match /quiz_results/{resultId} {
      // Only authenticated users can read their own results
      allow read: if isAuth() && isOwner(resource.data.uid);
      
      // Only authenticated users can create results
      allow create: if isAuth() && isOwner(request.resource.data.uid);
      
      // Users can update only their own results
      allow update: if isAuth() && isOwner(resource.data.uid);
      
      // Users can delete their own results
      allow delete: if isAuth() && isOwner(resource.data.uid);
    }

    // USER_PREFERENCES Collection - User settings and preferences
    match /user_preferences/{userId} {
      // Only authenticated users can read their own preferences
      allow read: if isAuth() && isOwner(userId);
      
      // Only authenticated users can create preferences
      allow create: if isAuth() && isOwner(request.resource.data.uid);
      
      // Users can update only their own preferences
      allow update: if isAuth() && isOwner(userId);
      
      // Users can delete their own preferences
      allow delete: if isAuth() && isOwner(userId);
    }

    // Default deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
